{
    "name": "fe-traceiron",
    "type": "module",
    "version": "0.0.5",
    "engines": {
        "node": ">=22.14.0"
    },
    "packageManager": "pnpm@11.9.0",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "wrangler dev --port 8788 --ip 127.0.0.1",
        "deploy": "astro build && wrangler deploy",
        "astro": "astro",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "check": "astro check && node scripts/check-i18n-parity.mjs",
        "check:i18n": "node scripts/check-i18n-parity.mjs",
        "check:budget": "node scripts/check-budget.mjs",
        "check:conformance": "node scripts/check-conformance.mjs",
        "check:all": "node scripts/check-i18n-parity.mjs && astro build && node scripts/check-budget.mjs && node scripts/check-conformance.mjs",
        "assets:brand": "bash scripts/build-brand-assets.sh",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:css": "stylelint \"src/**/*.{css,astro}\"",
        "lint:css:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.1.7",
        "astro": "^7.1.6",
        "wrangler": "^4.115.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.1.2",
        "astro-eslint-parser": "^3.0.0",
        "eslint": "^10.8.0",
        "eslint-plugin-astro": "^3.0.1",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "postcss-html": "^1.8.1",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
