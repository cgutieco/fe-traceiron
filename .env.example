# TRACEIRON — Variables de entorno
#
# Copiar a `.env` para desarrollo local. `.env` está en .gitignore.
# En Cloudflare, CLOUDKIT_API_TOKEN debe cargarse como *secret*, no como variable
# de texto plano:  wrangler secret put CLOUDKIT_API_TOKEN

# ── Servidor · NUNCA expuesto al cliente ─────────────────────────────────────
# Sin prefijo PUBLIC_. No debe aparecer jamás en el bundle del cliente.
# Debe emitirse en CloudKit Dashboard con permisos de SOLO LECTURA
# sobre la base de datos pública del contenedor iCloud.com.traceiron.app
CLOUDKIT_API_TOKEN=

# production | development
# Los registros creados por builds de desarrollo NO existen en production.
CLOUDKIT_ENV=development

# ── Cliente ──────────────────────────────────────────────────────────────────
# Identificador numérico de App Store — necesario para el Smart App
# Banner. Dejar vacío omite el banner en lugar de emitir
# una etiqueta inválida.
PUBLIC_APPSTORE_ID=

# URL completa de la ficha de App Store. NO DEBE codificarse en los
# componentes.
PUBLIC_APPSTORE_URL=

# Esquema URI de la app iOS (p. ej. traceiron://) para deep linking
PUBLIC_APP_SCHEME=

# ── Ambos ────────────────────────────────────────────────────────────────────
# Base de canonicals, hreflang y Open Graph.
PUBLIC_SITE_URL=https://traceiron.com
