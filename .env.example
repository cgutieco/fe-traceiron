# TRACEIRON — Variables de entorno
#
# Copiar a `.env` para desarrollo local. `.env` está en .gitignore.
# En Cloudflare, CLOUDKIT_API_TOKEN, TURNSTILE_SECRET_KEY y RESEND_API_KEY deben
# cargarse como *secrets*, no como variables de texto plano:
#   wrangler secret put CLOUDKIT_API_TOKEN
#   wrangler secret put TURNSTILE_SECRET_KEY
#   wrangler secret put RESEND_API_KEY

# ── Servidor · NUNCA expuesto al cliente ─────────────────────────────────────
# Sin prefijo PUBLIC_. No debe aparecer jamás en el bundle del cliente.
# Debe emitirse en CloudKit Dashboard con permisos de SOLO LECTURA
# sobre la base de datos pública del contenedor iCloud.com.traceiron.app
CLOUDKIT_API_TOKEN=

# production | development
# Los registros creados por builds de desarrollo NO existen en production.
CLOUDKIT_ENV=development

# Secret key del sitio Turnstile (dashboard de Cloudflare), usado por el
# formulario de /support para verificar el token server-to-server.
TURNSTILE_SECRET_KEY=

# API key de Resend, usada para despachar el correo del formulario de /support.
# El dominio traceiron.com debe estar verificado en Resend (SPF/DKIM) antes de
# que el envío funcione.
RESEND_API_KEY=

# ── Cliente ──────────────────────────────────────────────────────────────────
# Identificador numérico de App Store — necesario para el Smart App
# Banner. Dejar vacío omite el banner en lugar de emitir
# una etiqueta inválida.
PUBLIC_APPSTORE_ID=

# URL completa de la ficha de App Store. NO DEBE codificarse en los
# componentes.
PUBLIC_APPSTORE_URL=

# Esquema URI de la app iOS (p. ej. traceiron://) para deep linking
PUBLIC_APP_SCHEME=

# Site key (pública) del sitio Turnstile — inicializa el widget anti-bot en
# el formulario de /support. Dejar vacío hace que el widget no cargue.
PUBLIC_TURNSTILE_SITE_KEY=

# ── Ambos ────────────────────────────────────────────────────────────────────
# Base de canonicals, hreflang y Open Graph.
PUBLIC_SITE_URL=https://traceiron.com
