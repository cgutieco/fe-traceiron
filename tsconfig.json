{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@app/*": ["src/app/*"],
            "@views/*": ["src/views/*"],
            "@widgets/*": ["src/widgets/*"],
            "@features/*": ["src/features/*"],
            "@entities/*": ["src/entities/*"],
            "@shared/*": ["src/shared/*"]
        }
    },
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"]
}
